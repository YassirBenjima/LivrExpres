<!doctype html>
<html lang="{{ lang|default('fr') }}">
<head>
  <meta charset="utf-8">
  <title>{% if lang == 'en' %}Return Slip{% else %}Bon de retour{% endif %} {{ demande.bonReference }}</title>
  <style>
    @page {
      margin: 12mm 14mm 14mm 14mm;
    }
    * {
      box-sizing: border-box;
    }
    body {
      font-family: DejaVu Sans, Arial, sans-serif;
      color: #1e293b;
      font-size: 9.5pt;
      line-height: 1.4;
      background-color: #ffffff;
    }

    /* Header Bar */
    .header-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 18px;
      padding-bottom: 14px;
      border-bottom: 3px solid #ef4444;
    }
    .header-table td {
      vertical-align: top;
    }
    .brand-title {
      font-size: 22pt;
      font-weight: 800;
      color: #ef4444;
      letter-spacing: -0.5px;
      margin: 0;
      line-height: 1;
    }
    .brand-sub {
      font-size: 8.5pt;
      color: #64748b;
      margin-top: 4px;
      font-weight: 600;
    }
    .logo-img {
      max-height: 38px;
      max-width: 180px;
    }
    .doc-badge-box {
      text-align: right;
    }
    .doc-title {
      font-size: 16pt;
      font-weight: 800;
      color: #0f172a;
      text-transform: uppercase;
      margin: 0;
      letter-spacing: 0.5px;
    }
    .doc-ref {
      font-size: 11pt;
      font-weight: 700;
      color: #ef4444;
      margin-top: 4px;
    }
    .doc-date {
      font-size: 8.5pt;
      color: #64748b;
      margin-top: 2px;
    }

    /* Two-Column Info Cards */
    .info-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
    }
    .info-card {
      width: 48%;
      vertical-align: top;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 6px;
      padding: 10px 12px;
    }
    .info-card-title {
      font-size: 8.5pt;
      font-weight: 700;
      color: #ef4444;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 6px;
      border-bottom: 1px solid #cbd5e1;
      padding-bottom: 3px;
    }
    .info-row {
      font-size: 9pt;
      margin-bottom: 3px;
      color: #334155;
    }
    .info-label {
      font-weight: 700;
      color: #64748b;
    }

    /* Section Title */
    .section-header {
      font-size: 11pt;
      font-weight: 800;
      color: #0f172a;
      margin: 0 0 8px 0;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }

    /* Colis Main Table */
    .colis-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
    }
    .colis-table th {
      background-color: #1e293b;
      color: #ffffff;
      font-size: 8.5pt;
      font-weight: 700;
      text-transform: uppercase;
      padding: 8px 10px;
      text-align: left;
      border: 1px solid #1e293b;
    }
    .colis-table td {
      font-size: 9pt;
      padding: 8px 10px;
      border: 1px solid #e2e8f0;
      color: #334155;
      vertical-align: middle;
    }
    .colis-table tr:nth-child(even) td {
      background-color: #f8fafc;
    }

    /* Tracking & Badges */
    .tracking-code {
      font-family: DejaVu Sans Mono, monospace, sans-serif;
      font-weight: 700;
      color: #0f172a;
      background: #fef2f2;
      border: 1px solid #fecdd3;
      padding: 2px 6px;
      border-radius: 4px;
      display: inline-block;
      font-size: 8.5pt;
    }

    /* Summary Row */
    .summary-row td {
      background-color: #f1f5f9 !important;
      font-weight: 800;
      font-size: 9.5pt;
      color: #0f172a;
      border-top: 2px solid #94a3b8;
    }

    /* Signatures Section */
    .signatures-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 22px;
      margin-bottom: 14px;
    }
    .signature-card {
      width: 48%;
      vertical-align: top;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      padding: 10px 12px;
      height: 90px;
      background: #fafafa;
    }
    .signature-title {
      font-size: 8.5pt;
      font-weight: 700;
      color: #0f172a;
      text-transform: uppercase;
      margin-bottom: 4px;
    }
    .signature-note {
      font-size: 7.5pt;
      color: #64748b;
      font-style: italic;
    }

    /* Footer Copyright Note */
    .legal-footer {
      border-top: 1px solid #e2e8f0;
      padding-top: 8px;
      font-size: 7.5pt;
      color: #94a3b8;
      text-align: center;
      margin-top: 16px;
    }
  </style>
</head>
<body>

  {% set is_en = (lang|default('fr')) == 'en' %}

  <!-- Top Header Table -->
  <table class="header-table">
    <tr>
      <td style="width: 55%;">
        {% if logo_data_uri %}
          <img class="logo-img" alt="LivrExpress" src="{{ logo_data_uri }}"/>
        {% else %}
          <h1 class="brand-title">LivrExpress</h1>
        {% endif %}
        <div class="brand-sub">{% if is_en %}Returns Management Service — Morocco{% else %}Service de Gestion des Retours — Maroc{% endif %}</div>
      </td>
      <td class="doc-badge-box" style="width: 45%;">
        <div class="doc-title">{% if is_en %}RETURN SLIP{% else %}BON DE RETOUR{% endif %}</div>
        <div class="doc-ref">{% if is_en %}Ref{% else %}Réf{% endif %}: {{ demande.bonReference }}</div>
        <div class="doc-date">{% if is_en %}Request Date{% else %}Date de demande{% endif %} : {{ demande.createdAt ? (is_en ? demande.createdAt|date('d/m/Y \\a\\t H:i') : demande.createdAt|date('d/m/Y \\à H:i')) : 'N/A' }}</div>
      </td>
    </tr>
  </table>

  <!-- Meta Info Cards (2 Columns) -->
  <table class="info-table">
    <tr>
      <!-- Left Card: Customer & Details -->
      <td class="info-card">
        <div class="info-card-title">{% if is_en %}Request Information{% else %}Informations de la Demande{% endif %}</div>
        <div class="info-row"><span class="info-label">{% if is_en %}Slip Ref :{% else %}Réf Bon :{% endif %}</span> <strong>{{ demande.bonReference }}</strong></div>
        <div class="info-row"><span class="info-label">{% if is_en %}Reception Mode :{% else %}Mode de Réception :{% endif %}</span> 
          {% if demande.receptionType == 'Par Livreur' %}
            {% if is_en %}By Driver{% else %}Par Livreur{% endif %}
          {% elseif demande.receptionType == 'En Agence' %}
            {% if is_en %}At Branch{% else %}En Agence{% endif %}
          {% else %}
            {{ demande.receptionType }}
          {% endif %}
        </div>
        <div class="info-row"><span class="info-label">{% if is_en %}Status :{% else %}Statut :{% endif %}</span> <strong>{{ status_label }}</strong></div>
      </td>
      
      <!-- Right Card: Dates & Remarques -->
      <td style="width: 4%;"></td>
      <td class="info-card">
        <div class="info-card-title">{% if is_en %}Tracking &amp; Validation{% else %}Suivi &amp; Validation{% endif %}</div>
        <div class="info-row"><span class="info-label">{% if is_en %}Total number of parcels :{% else %}Nombre total de colis :{% endif %}</span> <strong>{{ demande.colis|length }} {% if is_en %}parcels{% else %}colis{% endif %}</strong></div>
        <div class="info-row"><span class="info-label">{% if is_en %}Reception Date :{% else %}Date de Réception :{% endif %}</span> {{ demande.receivedAt ? demande.receivedAt|date('d/m/Y H:i') : (is_en ? 'Pending' : 'En attente') }}</div>
        <div class="info-row"><span class="info-label">{% if is_en %}Notes :{% else %}Remarque :{% endif %}</span> {{ demande.note ? demande.note : (is_en ? 'No notes' : 'Aucune note') }}</div>
      </td>
    </tr>
  </table>

  <!-- Colis Section Title -->
  <div class="section-header">{% if is_en %}Details of parcels to return{% else %}Détails des colis à retourner{% endif %}</div>

  <!-- Main Colis Table -->
  <table class="colis-table">
    <thead>
      <tr>
        <th style="width: 36px; text-align: center;">#</th>
        <th style="width: 140px;">{% if is_en %}Tracking Code{% else %}Code de Suivi{% endif %}</th>
        <th>{% if is_en %}Product Nature{% else %}Nature du Produit{% endif %}</th>
        <th>{% if is_en %}Recipient / Address{% else %}Destinataire / Adresse{% endif %}</th>
        <th style="width: 110px;">{% if is_en %}City{% else %}Ville{% endif %}</th>
        <th style="width: 95px; text-align: right;">{% if is_en %}Price (MAD){% else %}Prix (MAD){% endif %}</th>
      </tr>
    </thead>
    <tbody>
      {% set totalPrix = 0 %}
      {% for colis in demande.colis %}
        {% set totalPrix = totalPrix + (colis.price ? colis.price : 0) %}
        <tr>
          <td style="text-align: center; font-weight: bold; color: #64748b;">{{ loop.index }}</td>
          <td><span class="tracking-code">{{ colis.trackingCode }}</span></td>
          <td>{{ colis.productNature ? colis.productNature : (is_en ? 'Parcel' : 'Colis') }}</td>
          <td>{{ colis.recipient ? colis.recipient : '-' }}</td>
          <td>{{ colis.city ? colis.city : '-' }}</td>
          <td style="text-align: right; font-weight: bold; font-family: DejaVu Sans Mono, monospace;">
            {{ colis.price ? colis.price|number_format(2, ',', ' ') : '0,00' }} MAD
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="6" style="text-align: center; padding: 18px; color: #94a3b8;">
            {% if is_en %}No parcel associated with this return slip.{% else %}Aucun colis associé à ce bon de retour.{% endif %}
          </td>
        </tr>
      {% endfor %}

      <!-- Total Summary Row -->
      {% if demande.colis|length > 0 %}
        <tr class="summary-row">
          <td colspan="4" style="text-align: right; text-transform: uppercase;">{% if is_en %}Total returned parcels ({{ demande.colis|length }} parcels) :{% else %}Total des colis retournés ({{ demande.colis|length }} colis) :{% endif %}</td>
          <td colspan="2" style="text-align: right; font-family: DejaVu Sans Mono, monospace; color: #ef4444;">
            {{ totalPrix|number_format(2, ',', ' ') }} MAD
          </td>
        </tr>
      {% endif %}
    </tbody>
  </table>

  <!-- Signature Cards -->
  <table class="signatures-table">
    <tr>
      <td class="signature-card">
        <div class="signature-title">{% if is_en %}Signature &amp; Stamp Agency / Carrier{% else %}Signature &amp; Cachet Agence / Transporteur{% endif %}</div>
        <div class="signature-note">{% if is_en %}Validated during quality control at reception{% else %}Validé lors du contrôle qualité à la réception{% endif %}</div>
      </td>
      <td style="width: 4%;"></td>
      <td class="signature-card">
        <div class="signature-title">{% if is_en %}Signature &amp; Stamp Sender Client{% else %}Signature &amp; Cachet Client Expéditeur{% endif %}</div>
        <div class="signature-note">{% if is_en %}« Received compliant and returned to sender »{% else %}« Reçu conforme et retourné à l'expéditeur »{% endif %}</div>
      </td>
    </tr>
  </table>

  <!-- Legal Notice Footer -->
  <div class="legal-footer">
    {% if is_en %}
      This return slip certifies the delivery of returned parcels to the client. LivrExpress Morocco — Confidential Document.
    {% else %}
      Ce bon de retour atteste de la remise des colis retournés au client. LivrExpress Maroc — Document confidentiel.
    {% endif %}
  </div>

</body>
</html>
