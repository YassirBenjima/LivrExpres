<!doctype html>
{% set is_en = (lang|default('fr')) == 'en' %}
<html lang="{{ is_en ? 'en' : 'fr' }}">
<head>
  <meta charset="utf-8">
  <title>{{ is_en ? 'Delivery Slip' : 'Bon de livraison' }} {{ bon.reference }}</title>
  <style>
    @page {
      margin: 12mm 14mm 14mm 14mm;
    }
    * {
      box-sizing: border-box;
    }
    body {
      font-family: DejaVu Sans, Arial, sans-serif;
      color: #1e293b;
      font-size: 9.5pt;
      line-height: 1.4;
      background-color: #ffffff;
    }

    /* Header Bar */
    .header-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 18px;
      padding-bottom: 14px;
      border-bottom: 3px solid #1b84ff;
    }
    .header-table td {
      vertical-align: top;
    }
    .brand-title {
      font-size: 22pt;
      font-weight: 800;
      color: #1b84ff;
      letter-spacing: -0.5px;
      margin: 0;
      line-height: 1;
    }
    .brand-sub {
      font-size: 8.5pt;
      color: #64748b;
      margin-top: 4px;
      font-weight: 600;
    }
    .logo-img {
      max-height: 38px;
      max-width: 180px;
    }
    .doc-badge-box {
      text-align: right;
    }
    .doc-title {
      font-size: 16pt;
      font-weight: 800;
      color: #0f172a;
      text-transform: uppercase;
      margin: 0;
      letter-spacing: 0.5px;
    }
    .doc-ref {
      font-size: 11pt;
      font-weight: 700;
      color: #1b84ff;
      margin-top: 4px;
    }
    .doc-date {
      font-size: 8.5pt;
      color: #64748b;
      margin-top: 2px;
    }

    /* Two-Column Info Cards */
    .info-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
    }
    .info-card {
      width: 48%;
      vertical-align: top;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 6px;
      padding: 10px 12px;
    }
    .info-card-title {
      font-size: 8.5pt;
      font-weight: 700;
      color: #1b84ff;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 6px;
      border-bottom: 1px solid #cbd5e1;
      padding-bottom: 3px;
    }
    .info-row {
      font-size: 9pt;
      margin-bottom: 3px;
      color: #334155;
    }
    .info-label {
      font-weight: 700;
      color: #64748b;
    }

    /* Table for Colis */
    .section-header {
      font-size: 10pt;
      font-weight: 800;
      color: #0f172a;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 8px;
    }
    .colis-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
    }
    .colis-table th {
      background-color: #1b84ff;
      color: #ffffff;
      font-size: 8pt;
      font-weight: 800;
      text-transform: uppercase;
      padding: 8px 10px;
      border: 1px solid #1b84ff;
    }
    .colis-table td {
      font-size: 8.5pt;
      padding: 8px 10px;
      border: 1px solid #e2e8f0;
      vertical-align: middle;
    }
    .colis-table tbody tr:nth-child(even) {
      background-color: #f8fafc;
    }
    .tracking-code {
      font-weight: bold;
      color: #0f172a;
      background: #e0f2fe;
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 8pt;
      display: inline-block;
    }

    /* Table Total Summary Row */
    .summary-row td {
      background-color: #f1f5f9;
      font-weight: 800;
      font-size: 9.5pt;
      color: #0f172a;
      border-top: 2px solid #cbd5e1;
    }

    /* Signatures Table */
    .signatures-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 15px;
      margin-bottom: 20px;
    }
    .signature-card {
      width: 48%;
      vertical-align: top;
      border: 1px dashed #cbd5e1;
      border-radius: 6px;
      padding: 10px 12px;
      height: 90px;
      background: #fafafa;
    }
    .signature-title {
      font-size: 8.5pt;
      font-weight: 700;
      color: #0f172a;
      text-transform: uppercase;
      margin-bottom: 4px;
    }
    .signature-note {
      font-size: 7.5pt;
      color: #64748b;
      font-style: italic;
    }

    /* Footer Copyright Note */
    .legal-footer {
      border-top: 1px solid #e2e8f0;
      padding-top: 8px;
      font-size: 7.5pt;
      color: #94a3b8;
      text-align: center;
      margin-top: 16px;
    }
  </style>
</head>
<body>

  <!-- Top Header Table -->
  <table class="header-table">
    <tr>
      <td style="width: 55%;">
        {% if logo_data_uri %}
          <img class="logo-img" alt="LivrExpress" src="{{ logo_data_uri }}"/>
        {% else %}
          <h1 class="brand-title">LivrExpress</h1>
        {% endif %}
        <div class="brand-sub">Express Delivery & Supply Chain Logistics — {{ is_en ? 'Morocco' : 'Maroc' }}</div>
      </td>
      <td class="doc-badge-box" style="width: 45%;">
        <div class="doc-title">{{ is_en ? 'Delivery Slip' : 'Bon de Livraison' }}</div>
        <div class="doc-ref">{{ is_en ? 'Ref:' : 'Réf:' }} {{ bon.reference }}</div>
        <div class="doc-date">
          {{ is_en ? 'Issued on :' : 'Émis le :' }} {{ bon.createdAt ? bon.createdAt|date(is_en ? 'm/d/Y \\a\\t H:i' : 'd/m/Y à H:i') : 'N/A' }}
        </div>
      </td>
    </tr>
  </table>

  <!-- Meta Info Cards (2 Columns) -->
  <table class="info-table">
    <tr>
      <!-- Left Card: Company/Transporter -->
      <td class="info-card">
        <div class="info-card-title">{{ is_en ? 'Sender / Transporter' : 'Émetteur / Transporteur' }}</div>
        <div class="info-row"><span class="info-label">{{ is_en ? 'Company :' : 'Société :' }}</span> LivrExpress Logistics</div>
        <div class="info-row"><span class="info-label">{{ is_en ? 'Department :' : 'Service :' }}</span> {{ is_en ? 'Shipment Management' : 'Gestion des expéditions' }}</div>
        <div class="info-row"><span class="info-label">{{ is_en ? 'Slip status :' : 'Statut du bon :' }}</span> <strong>{{ status_label }}</strong></div>
      </td>
      
      <!-- Right Card: Delivery Summary -->
      <td style="width: 4%;"></td>
      <td class="info-card">
        <div class="info-card-title">{{ is_en ? 'Shipment Summary' : 'Résumé du Chargement' }}</div>
        <div class="info-row"><span class="info-label">{{ is_en ? 'Total parcels :' : 'Nombre total de colis :' }}</span> <strong>{{ bon.colis|length }} {{ is_en ? 'parcels' : 'colis' }}</strong></div>
        <div class="info-row"><span class="info-label">{{ is_en ? 'Registered on :' : 'Enregistré le :' }}</span> {{ bon.registeredAt ? bon.registeredAt|date(is_en ? 'm/d/Y H:i' : 'd/m/Y H:i') : '-' }}</div>
        <div class="info-row"><span class="info-label">{{ is_en ? 'Document Ref :' : 'Document Réf :' }}</span> {{ bon.reference }}</div>
      </td>
    </tr>
  </table>

  <!-- Colis Section Title -->
  <div class="section-header">{{ is_en ? 'Details of Shipped Parcels' : 'Détails des colis expédiés' }}</div>

  <!-- Main Colis Table -->
  <table class="colis-table">
    <thead>
      <tr>
        <th style="width: 36px; text-align: center;">#</th>
        <th style="width: 140px;">{{ is_en ? 'Tracking Code' : 'Code de Suivi' }}</th>
        <th>{{ is_en ? 'Recipient / Client' : 'Destinataire / Client' }}</th>
        <th style="width: 110px;">{{ is_en ? 'City' : 'Ville' }}</th>
        <th>{{ is_en ? 'Product Nature' : 'Nature du Produit' }}</th>
        <th style="width: 95px; text-align: right;">{{ is_en ? 'Price (MAD)' : 'Prix (MAD)' }}</th>
      </tr>
    </thead>
    <tbody>
      {% set totalPrix = 0 %}
      {% for colis in bon.colis %}
        {% set totalPrix = totalPrix + (colis.price ? colis.price : 0) %}
        <tr>
          <td style="text-align: center; font-weight: bold; color: #64748b;">{{ loop.index }}</td>
          <td><span class="tracking-code">{{ colis.trackingCode }}</span></td>
          <td><strong>{{ colis.recipient ? colis.recipient : '-' }}</strong></td>
          <td>{{ colis.city ? colis.city : '-' }}</td>
          <td>{{ colis.productNature ? colis.productNature : (is_en ? 'Parcel' : 'Produit test') }}</td>
          <td style="text-align: right; font-weight: bold; font-family: DejaVu Sans Mono, monospace;">
            {{ colis.price ? colis.price|number_format(2, ',', ' ') : '0,00' }} MAD
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="6" style="text-align: center; padding: 18px; color: #94a3b8;">
            {{ is_en ? 'No parcels associated with this delivery slip.' : 'Aucun colis associé à ce bon de livraison.' }}
          </td>
        </tr>
      {% endfor %}

      <!-- Total Summary Row -->
      {% if bon.colis|length > 0 %}
        <tr class="summary-row">
          <td colspan="4" style="text-align: right; text-transform: uppercase;">
            {{ is_en ? 'Grand Total' : 'Total Général' }} ({{ bon.colis|length }} {{ is_en ? 'parcels' : 'colis' }}) :
          </td>
          <td colspan="2" style="text-align: right; font-family: DejaVu Sans Mono, monospace; color: #1b84ff;">
            {{ totalPrix|number_format(2, ',', ' ') }} MAD
          </td>
        </tr>
      {% endif %}
    </tbody>
  </table>

  <!-- Signature Cards -->
  <table class="signatures-table">
    <tr>
      <td class="signature-card">
        <div class="signature-title">{{ is_en ? 'Transporter Signature & Stamp' : 'Signature & Cachet Transporteur' }}</div>
        <div class="signature-note">{{ is_en ? 'Handed by driver / LivrExpress representative' : 'Remis par le livreur / représentant LivrExpress' }}</div>
      </td>
      <td style="width: 4%;"></td>
      <td class="signature-card">
        <div class="signature-title">{{ is_en ? 'Recipient Signature & Stamp' : 'Signature & Cachet Réceptionnaire' }}</div>
        <div class="signature-note">{{ is_en ? '« Good for compliant receipt of listed parcels »' : '« Bon pour réception conforme des colis énumérés »' }}</div>
      </td>
    </tr>
  </table>

  <!-- Legal Notice Footer -->
  <div class="legal-footer">
    {{ is_en ? 'This delivery slip serves as proof of receipt and shipment of the parcels listed above. LivrExpress Morocco — Confidential computer document.' : 'Ce bon de livraison fait foi de la prise en charge et de l\'expédition des colis mentionnés ci-dessus. LivrExpress Maroc — Document informatique confidentiel.' }}
  </div>

</body>
</html>
